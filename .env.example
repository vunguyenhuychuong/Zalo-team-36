# Copy file nay thanh `.env` (khong co duoi) roi dien gia tri thuc.
# `.env` da nam trong .gitignore - khong bao gio commit key len git.

# FPT AI Marketplace - lay tai https://marketplace.fptcloud.com/en/my-account?tab=my-api-key
FPT_API_KEY=sk-thay-bang-key-cua-ban

# Model dung cho bot. Da do bang scripts/test-fpt-models.sh - xem bang so sanh
# trong README truoc khi doi.
FPT_MODEL=gemma-4-31B-it

# Mat khau khu vuc noi bo (/advisor + hang doi lead).
# Bo trong thi server dung mat khau mac dinh va canh bao luc khoi dong.
INTERNAL_PASSWORD=

# Cong tac tat luong chat. Dat false roi deploy lai la tat trong ~30 giay.
# Tai lieu (muc Orchestration): "Neu agent bao sai gia, chinh sach hoac cam ket
# tinh nang, tam khoa luong do cho toi khi qua kiem thu."
# Man SME dang form van chay binh thuong khi tat.
CHAT_ENABLED=true

# Zalo Bot token - CHI de o server, tuyet doi khong dua ra frontend.
# Token nam trong URL path va khong tu het han, ro ri mot lan la mat quyen dieu khien bot.
ZALO_BOT_TOKEN=
